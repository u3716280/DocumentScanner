<?xml version="1.0" encoding="utf-8"?>
<!-- A WPF test that opens a modal dialog never returns on CI. Abort after 3 minutes and name the running test. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame" enabled="True">
        <Configuration>
          <CollectDumpOnTestSessionHang TestTimeout="3min" HangDumpType="none" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
