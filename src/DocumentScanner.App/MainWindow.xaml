<ui:FluentWindow x:Class="DocumentScanner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:DocumentScanner.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Document Scanner" Width="1440" Height="960" MinWidth="1000" MinHeight="700" Closing="OnClosing"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource InkBrush}">
    <!--
        Theme resources are not declared here: App.xaml provides them, and ThemeResources.Ensure
        adds them to this window when it is created without an Application. Brushes and styles are
        therefore DynamicResource; only the converters below are local.

        The workspace reads left to right in the order of the job: scan, review, save and send.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </ui:FluentWindow.InputBindings>
    <Grid Background="{DynamicResource MistBrush}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
            <l:SelectionDisplayConverter x:Key="SelectionDisplay"/>
            <!--
                Page-list checkbox. Deliberately self-contained and without animations: page items are removed and
                re-created on every edit, and a library style that is looked up through the tree is re-evaluated when
                an item leaves it. With the theme held by the window (no Application), that tears down an animated
                template mid-animation and throws.
            -->
            <Style x:Key="PageCheck" TargetType="CheckBox">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="2,2,8,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Background="White" BorderBrush="#8D98A5" BorderThickness="1.5" CornerRadius="4">
                                <Path x:Name="Mark" Data="M 3.5 8.5 L 7 12 L 13.5 5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource LampBrush}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource LampBrush}"/>
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                                    <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Document Scanner">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Scan24"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button Content="Settings" Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent" BorderThickness="0" Click="SettingsClick" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Application settings and data folder"/>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" MinWidth="248"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="296" MinWidth="272"/>
            </Grid.ColumnDefinitions>

            <!-- Scan: profile, scanner, settings for the next scan, and the scan action. -->
            <Border Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource IdleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScannerReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ScannerStatus}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button x:Name="ScanButton" Content="{Binding ScanButtonText}" Icon="{ui:SymbolIcon Scan24}" Appearance="Primary" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" MinHeight="44" FontWeight="SemiBold"/>
                        <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>
                    <TabControl x:Name="SettingsTabs" IsEnabled="{Binding NotBusy}" Background="Transparent" BorderThickness="0" Margin="8,4,0,0">
                        <TabItem Header="Scan settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,4,16,16">
                                    <TextBlock Text="Profile" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Scanner profile"/>
                                    <TextBlock Text="{Binding ProfileState}" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                                    <ui:Button Content="Manage profiles" Command="{Binding ProfileManagerCommand}" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" Padding="0,4" Margin="0,2,0,0"/>

                                    <TextBlock Text="Scanner" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Scanner device and driver" ToolTip="{Binding DeviceDetails}"/>
                                    <TextBlock Text="{Binding CapabilityWarning}" Foreground="{DynamicResource BlankBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,6"/>
                                    <TextBlock Text="These settings apply to the next scan." Style="{DynamicResource Caption}"/>

                                    <TextBlock Text="Paper source" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan paper source"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Resolution (DPI)" Style="{DynamicResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Dpis}" SelectedItem="{Binding SelectedDpi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan DPI"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color mode" Style="{DynamicResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan color"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Paper size" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan paper size"/>

                                    <ui:ToggleSwitch Content="Auto deskew" IsChecked="{Binding Deskew}" Margin="0,14,0,0"/>
                                    <ui:ToggleSwitch Content="Auto crop" IsChecked="{Binding AutoCrop}" Margin="0,10,0,0"/>

                                    <Expander Header="Advanced settings" Margin="0,16,0,0">
                                        <StackPanel Margin="0,4,0,0">
                                            <CheckBox Content="Landscape" IsChecked="{Binding Landscape}"/>
                                            <CheckBox Content="Mark possible blank pages" IsChecked="{Binding DetectBlank}"/>
                                            <CheckBox Content="Review blank removal after scan" IsChecked="{Binding RemoveBlank}"/>
                                            <CheckBox Content="Use native scanner dialog" IsChecked="{Binding NativeUi}" ToolTip="{l:Loc NativeToneHint}"/>
                                            <TextBlock Text="Brightness, from −1000 to 1000" Style="{DynamicResource FieldLabel}"/>
                                            <TextBox Text="{Binding Brightness,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="Next scan brightness"/>
                                            <TextBlock Text="Contrast, from −1000 to 1000" Style="{DynamicResource FieldLabel}"/>
                                            <TextBox Text="{Binding Contrast,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="Next scan contrast"/>
                                            <ui:Button Content="Reset scan tone to 0" Command="{Binding ResetAdjustmentsCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Scanner connections" Margin="0,8,0,0">
                                        <StackPanel Margin="0,4,0,0">
                                            <ui:Button Content="Find all scanners" Command="{Binding ResetProfileCommand}" HorizontalAlignment="Stretch" ToolTip="Reset the active profile and search all scanner interfaces. Saved profiles and the default profile are kept. F5."/>
                                            <TextBlock Text="IP / eSCL endpoint" Style="{DynamicResource FieldLabel}"/>
                                            <TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="IP or eSCL endpoint"/>
                                            <ui:Button Content="Connect scanner" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Edit page">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,12,16,16">
                                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Edits apply to the selected pages only." Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                                    <StackPanel IsEnabled="{Binding HasSelection}" Margin="0,8,0,0">
                                        <TextBlock Text="Brightness" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="-1000" Maximum="1000" SmallChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding PageBrightness,Mode=TwoWay}" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Selected page brightness"/>
                                            <TextBox Grid.Column="1" Text="{Binding PageBrightness,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="Selected page brightness value"/>
                                        </Grid>
                                        <TextBlock Text="Contrast" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="-1000" Maximum="1000" SmallChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding PageContrast,Mode=TwoWay}" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Selected page contrast"/>
                                            <TextBox Grid.Column="1" Text="{Binding PageContrast,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" AutomationProperties.Name="Selected page contrast value"/>
                                        </Grid>
                                        <TextBlock Text="From −1000 to 1000. 0 leaves the page unchanged. The values shown are from the previewed page." Style="{DynamicResource Caption}" Margin="0,8,0,0"/>
                                        <ui:Button Content="Apply tone to selected pages" Command="{Binding ApplyPageToneCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                                        <ui:Button Content="Reset tone to 0" Command="{Binding ResetPageToneCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>

                                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,14"/>
                                        <TextBlock Text="Crop and color" FontWeight="SemiBold"/>
                                        <ui:Button Content="Manual crop" Icon="{ui:SymbolIcon Crop24}" Command="{Binding ManualCropCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                        <ui:Button Content="Auto crop selected pages" Command="{Binding CropCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                        <ui:Button Content="Reset crop" Command="{Binding ResetCropCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                        <ui:Button Content="Auto color" Icon="{ui:SymbolIcon Color24}" Command="{Binding AutoColorCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                        <ui:Button Content="Reset Auto Color" Command="{Binding ResetColorCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                        <TextBlock Text="Original images are kept. Undo restores the previous edit." Style="{DynamicResource Caption}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Review: page list and the page on the scanner glass. -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,1" Padding="12,4">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0"/>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Header="Rotate" IsEnabled="{Binding HasSelection}">
                                    <MenuItem Header="Rotate left" Command="{Binding RotateLeftCommand}"/>
                                    <MenuItem Header="Rotate right" Command="{Binding RotateRightCommand}"/>
                                    <MenuItem Header="Rotate 180°" Command="{Binding Rotate180Command}"/>
                                </MenuItem>
                            </Menu>
                            <ui:Button Content="Crop" Icon="{ui:SymbolIcon Crop24}" Command="{Binding ManualCropCommand}" Appearance="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="Manually crop one selected page"/>
                            <ui:Button Content="Undo" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" Appearance="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Header="More">
                                    <MenuItem Header="Auto color" Command="{Binding AutoColorCommand}"/>
                                    <MenuItem Header="Auto crop selected pages" Command="{Binding CropCommand}"/>
                                    <MenuItem Header="Reset crop" Command="{Binding ResetCropCommand}"/>
                                    <MenuItem Header="Reset Auto Color" Command="{Binding ResetColorCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Select possible blank pages" Click="SelectBlanksClick"/>
                                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}"/>
                                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}"/>
                                    <MenuItem Header="Delete selected pages" Command="{Binding DeleteCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Clear document (Undo available)" Command="{Binding ClearCommand}"/>
                                </MenuItem>
                            </Menu>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,8,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PagesHeading}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ui:Button Grid.Column="1" Content="All" Click="SelectAllClick" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" Padding="6,3" ToolTip="Select all pages"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
                            <ui:Button Content="Import images…" Icon="{ui:SymbolIcon ImageAdd24}" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch"/>
                            <ui:Button Content="New document" Command="{Binding NewDocumentCommand}" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Extended" SelectionChanged="PagesChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="PagesDrop" AutomationProperties.Name="Scanned pages; use checkboxes or Ctrl and Shift to select pages">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,8,8,6"/>
                                    <Setter Property="Margin" Value="6,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="PageChrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MistBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource LampTintBrush}"/>
                                                        <Setter TargetName="PageChrome" Property="BorderBrush" Value="{DynamicResource LampBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="PageChrome" Property="BorderBrush" Value="{DynamicResource LampBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource PageCheck}" IsChecked="{Binding IsSelected,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Top" ToolTip="Include this page in output" AutomationProperties.Name="Select page"/>
                                        <StackPanel Grid.Column="1">
                                            <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="3">
                                                <Image Source="{Binding Thumbnail}" Height="112" Stretch="Uniform">
                                                    <Image.LayoutTransform>
                                                        <RotateTransform Angle="{Binding Rotation}"/>
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="{Binding BlankText}" Foreground="{DynamicResource BlankBrush}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- The scanner glass. The only dark surface, so the page is the brightest thing on screen. -->
                <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource PlatenBrush}" ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding PreviewEmptyTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PlatenTextBrush}" TextAlignment="Center"/>
                        <TextBlock Text="{Binding PreviewEmptyHint}" Foreground="{DynamicResource PlatenMutedBrush}" Margin="16,10" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="PreviewContainer" Width="{Binding ViewportWidth,ElementName=PreviewScroll}" Height="{Binding ViewportHeight,ElementName=PreviewScroll}" Background="Transparent">
                            <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" Margin="28">
                                <Image.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                    </ScrollViewer>
                    <!-- Scan lamp: one pass of light across the glass while the application is working. Off when Windows animations are off. -->
                    <Rectangle Height="3" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{DynamicResource LampGlowBrush}">
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#7FE3F2" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Rectangle.Effect>
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="-12"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Busy}" Value="True"/>
                                            <!-- Only in a window that is on screen: a repeating animation in a windowless host keeps the dispatcher from going idle. -->
                                            <Condition Binding="{Binding IsLoaded,RelativeSource={RelativeSource Self}}" Value="True"/>
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard Name="LampSweep">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="1400" Duration="0:0:2.6" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LampSweep"/>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Grid>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Original" GroupName="PreviewMode" IsChecked="{Binding ShowOriginal,Mode=TwoWay}" MinWidth="0" Margin="0,0,16,0"/>
                            <RadioButton Content="Adjusted" GroupName="PreviewMode" IsChecked="{Binding ShowAdjusted,Mode=TwoWay}" MinWidth="0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PreviewInfo}" Style="{DynamicResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" Margin="12,0" ToolTip="The original scan is kept. Edits are applied on top of it."/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Icon="{ui:SymbolIcon ZoomOut24}" Click="ZoomOutClick" Appearance="Transparent" BorderThickness="0" ToolTip="Zoom out" AutomationProperties.Name="Zoom out"/>
                            <ui:Button Content="Fit" Click="FitClick" Appearance="Transparent" BorderThickness="0" ToolTip="Fit the page to the view" AutomationProperties.Name="Fit page to view"/>
                            <ui:Button Icon="{ui:SymbolIcon ZoomIn24}" Click="ZoomInClick" Appearance="Transparent" BorderThickness="0" ToolTip="Zoom in" AutomationProperties.Name="Zoom in"/>
                            <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Zoom relative to Fit"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Save and send: output, destination, and the three delivery actions. -->
            <Border Grid.Column="4" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
                        <ui:Button Content="Retry pending delivery…" Command="{Binding RetryUploadCommand}" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" Padding="0,4" Margin="0,0,0,8" Visibility="{Binding HasPendingDelivery,Converter={StaticResource BoolVisibility}}"/>
                        <ui:Button x:Name="SendErpButton" Content="Send to ERPNext" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Command="{Binding SendCommand}" HorizontalAlignment="Stretch" MinHeight="44" FontWeight="SemiBold" ToolTip="Choose an ERPNext document, review and confirm before uploading"/>
                        <ui:Button x:Name="SaveLocalButton" Content="Save to folder" Icon="{ui:SymbolIcon Folder24}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" MinHeight="38" Margin="0,8,0,0" ToolTip="Save selected pages to a local folder"/>
                        <ui:Button x:Name="SaveAndSendButton" Content="Save and send" Command="{Binding SaveAndSendCommand}" HorizontalAlignment="Stretch" MinHeight="38" Margin="0,8,0,0" ToolTip="Save selected pages locally first, then upload to a confirmed ERPNext document"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="Save and send" Style="{DynamicResource SectionTitle}"/>
                            <TextBlock Text="{Binding SelectionSummary}" Margin="0,4,0,0"/>

                            <TextBlock Text="Format" Style="{DynamicResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" IsEnabled="{Binding NotBusy}" AutomationProperties.Name="Output format">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SelectionDisplay}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Filename prefix" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Text="{Binding FilenamePrefix,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotBusy}" AutomationProperties.Name="Filename prefix"/>
                            <TextBlock Text="{Binding FilenamePreview}" Style="{DynamicResource Caption}" Margin="0,6,0,0" ToolTip="{Binding FilenamePreview}"/>

                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,14"/>
                            <StackPanel IsEnabled="{Binding NotBusy}">
                                <TextBlock Text="ERPNext" Style="{DynamicResource SectionTitle}"/>
                                <TextBlock Text="Destination not confirmed" Margin="0,6,0,0"/>
                                <TextBlock Text="Choose and confirm a document before each upload." Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding BridgeStatus}" Style="{DynamicResource Caption}" Margin="0,12,0,0"/>
                                <TextBlock Text="Search and upload need the Document Scanner Bridge on your ERPNext site." Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                <ui:Button Content="Test connection" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestErpConnectionCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                <ui:Button Content="Setup guide" Command="{Binding BridgeGuideCommand}" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" Padding="0,4" Margin="0,6,0,0"/>
                                <ui:Button Content="Manage sites / credentials" Command="{Binding ManageErpSitesCommand}" Appearance="Transparent" BorderThickness="0" Foreground="{DynamicResource LampBrush}" Padding="0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding SessionSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
