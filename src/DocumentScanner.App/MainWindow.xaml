<Window x:Class="DocumentScanner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:DocumentScanner.App" Title="{l:Loc Title}" Width="1250" Height="820" MinWidth="900" MinHeight="600" Closing="OnClosing">
<Window.InputBindings>
 <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
 <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
 <KeyBinding Key="N" Modifiers="Control" Command="{Binding ClearCommand}"/>
 <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
 <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
 <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
</Window.InputBindings>
<DockPanel>
 <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,0,0,1" Padding="18,12">
  <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Settings}" Click="SettingsClick"/><StackPanel><TextBlock Text="{l:Loc Title}" FontSize="23" FontWeight="SemiBold" Foreground="#1A2D4B"/><TextBlock Text="{l:Loc Subtitle}" Foreground="#6D7B92" Margin="0,4,0,8"/></StackPanel></DockPanel>
   <WrapPanel VerticalAlignment="Center"><ComboBox Width="325" Margin="0,3,8,3" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding NotBusy}" ToolTip="{Binding DeviceDetails}"/>
    <Button Content="{l:Loc Refresh}" Command="{Binding RefreshCommand}"/>
    <Button Content="{l:Loc Scan}" Command="{Binding ScanCommand}" Background="#2367D1" Foreground="White"/>
    <Button Content="{l:Loc ScanMore}" Command="{Binding ScanCommand}"/>
    <Button Content="{l:Loc Cancel}" Command="{Binding CancelCommand}"/>
    <Button Content="{l:Loc Save}" Command="{Binding SaveCommand}"/>
    <Button Content="{l:Loc Import}" Command="{Binding ImportCommand}"/>
   </WrapPanel>
  </StackPanel>
 </Border>
 <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,1,0,0" Padding="14,10">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/><ProgressBar Height="3" Margin="0,6,16,0" IsIndeterminate="{Binding Busy}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PageSummary}" VerticalAlignment="Center"/></Grid>
 </Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
  <DockPanel Background="#EBEFF6">
   <WrapPanel DockPanel.Dock="Top" Margin="8"><Button Content="{l:Loc SelectAll}" Click="SelectAllClick"/><Button Content="{l:Loc RemoveBlank}" Click="SelectBlanksClick"/></WrapPanel>
   <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Extended" SelectionChanged="PagesChanged" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="PagesDrop">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Width="155" Margin="8,7"><Border Background="White" Padding="6" BorderBrush="#D1D9E6" BorderThickness="1"><Image Source="{Binding Thumbnail}" Height="140" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="{Binding Rotation}"/></Image.LayoutTransform></Image></Border><TextBlock Text="{Binding Label}" Margin="0,6,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding BlankText}" Foreground="#A76500" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
  <DockPanel Grid.Column="2" Margin="10">
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
    <Button Content="{l:Loc RotateLeft}" Command="{Binding RotateLeftCommand}"/><Button Content="{l:Loc RotateRight}" Command="{Binding RotateRightCommand}"/><Button Content="{l:Loc Rotate180}" Command="{Binding Rotate180Command}"/>
    <Button Content="{l:Loc MoveUp}" Command="{Binding MoveUpCommand}"/><Button Content="{l:Loc MoveDown}" Command="{Binding MoveDownCommand}"/><Button Content="{l:Loc Delete}" Command="{Binding DeleteCommand}"/>
    <Button Content="{l:Loc Undo}" Command="{Binding UndoCommand}"/><Button Content="{l:Loc Crop}" Command="{Binding CropCommand}"/><Button Content="{l:Loc ResetCrop}" Command="{Binding ResetCropCommand}"/><Button Content="{l:Loc Clear}" Command="{Binding ClearCommand}"/>
   </WrapPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewInfo}" HorizontalAlignment="Center" Foreground="#52627C" Margin="0,6"/>
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"><Button Content="{l:Loc ZoomOut}" Click="ZoomOutClick"/><Button Content="{l:Loc Fit}" Click="FitClick"/><Button Content="{l:Loc ZoomIn}" Click="ZoomInClick"/></StackPanel>
   <Grid Background="#E1E6EF" ClipToBounds="True">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock Text="{l:Loc NoPages}" FontSize="18" Foreground="#58677F" TextAlignment="Center"/><TextBlock Text="{l:Loc EmptyHint}" TextWrapping="Wrap" MaxWidth="300" Margin="0,10" Foreground="#748197" TextAlignment="Center"/></StackPanel>
    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="PreviewContainer" Width="{Binding ActualWidth,ElementName=PreviewScroll}" Height="{Binding ActualHeight,ElementName=PreviewScroll}" Background="Transparent"><Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" Margin="18"/></Grid></ScrollViewer>
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
  <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="White"><StackPanel Margin="18" IsEnabled="{Binding NotBusy}">
   <Expander Header="{l:Loc ScanSettings}" IsExpanded="True"><StackPanel Margin="0,12,0,5">
    <TextBlock Text="{Binding CapabilityWarning}" TextWrapping="Wrap" Foreground="#A76500" Margin="0,0,0,7"/>
    <Label Content="{l:Loc Source}"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    <Label Content="{l:Loc Dpi}"/><ComboBox ItemsSource="{Binding Dpis}" SelectedItem="{Binding SelectedDpi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    <Label Content="{l:Loc Color}"/><ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    <Label Content="{l:Loc Paper}"/><ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{l:Loc AutoNotice}" FontSize="11" Foreground="#758197" TextWrapping="Wrap"/>
    <CheckBox Content="{l:Loc Landscape}" IsChecked="{Binding Landscape}"/><CheckBox Content="{l:Loc Deskew}" IsChecked="{Binding Deskew}"/>
    <CheckBox Content="{l:Loc AutoCrop}" IsChecked="{Binding AutoCrop}"/><CheckBox Content="{l:Loc BlankDetection}" IsChecked="{Binding DetectBlank}"/><CheckBox Content="{l:Loc NativeUi}" IsChecked="{Binding NativeUi}" ToolTip="{l:Loc NativeToneHint}"/>
    <Label Content="{l:Loc Brightness}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
     <Slider Minimum="-1000" Maximum="1000" TickFrequency="100" SmallChange="10" LargeChange="100" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" Value="{Binding Brightness,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox Grid.Column="1" IsReadOnly="True" IsTabStop="False" TextAlignment="Center" Text="{Binding Brightness,Mode=OneWay}" Margin="0,4"/>
    </Grid>
    <Label Content="{l:Loc Contrast}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
     <Slider Minimum="-1000" Maximum="1000" TickFrequency="100" SmallChange="10" LargeChange="100" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" Value="{Binding Contrast,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox Grid.Column="1" IsReadOnly="True" IsTabStop="False" TextAlignment="Center" Text="{Binding Contrast,Mode=OneWay}" Margin="0,4"/>
    </Grid>
    <Button Content="{l:Loc ResetAdjustments}" Command="{Binding ResetAdjustmentsCommand}"/>
    <TextBlock Text="{l:Loc ToneHint}" TextWrapping="Wrap" FontSize="11" Foreground="#758197" Margin="0,4,0,8"/>
   </StackPanel></Expander>
   <Separator Margin="0,12"/>
   <Expander Header="{l:Loc Profiles}"><StackPanel Margin="0,10"><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/><Label Content="{l:Loc ProfileName}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="{l:Loc SaveProfile}" Command="{Binding SaveProfileCommand}"/><Button Content="{l:Loc LoadProfile}" Command="{Binding LoadProfileCommand}"/><Button Content="{l:Loc DeleteProfile}" Command="{Binding DeleteProfileCommand}"/><Button Content="{l:Loc SetDefault}" Command="{Binding DefaultCommand}"/></WrapPanel></StackPanel></Expander>
   <Separator Margin="0,12"/>
   <Expander Header="{l:Loc Network}"><StackPanel Margin="0,10"><Label Content="{l:Loc Endpoint}"/><TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}"/><Button Content="{l:Loc Connect}" Command="{Binding ConnectCommand}"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
 </Grid>
</DockPanel></Window>
