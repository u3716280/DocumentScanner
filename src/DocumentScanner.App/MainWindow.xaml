<Window x:Class="DocumentScanner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:DocumentScanner.App" Title="Document Scanner" Width="1440" Height="960" MinWidth="1000" MinHeight="700" Closing="OnClosing">
 <Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}"/><KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/><KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Window.InputBindings>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#CCD5E2" BorderThickness="0,0,0,1" Padding="18,12">
   <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Settings" Click="SettingsClick"/><TextBlock Text="Document Scanner" FontSize="23" FontWeight="SemiBold" Foreground="#17263C"/></DockPanel>
    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center"><TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" IsEnabled="{Binding NotBusy}" AutomationProperties.Name="Scanner profile"/><Button Content="Manage profiles…" Command="{Binding ProfileManagerCommand}"/><ComboBox Width="260" Margin="12,4,8,10" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding NotBusy}" AutomationProperties.Name="Scanner device and driver" ToolTip="{Binding DeviceDetails}"/><Button Content="Reset Profile" Command="{Binding ResetProfileCommand}" ToolTip="Clear the active profile and search all scanner interfaces. Saved profiles and the default profile are kept."/><Button Content="Scan" Command="{Binding ScanCommand}" Background="#075DE8" Foreground="White"/><Button Content="Scan more" Command="{Binding ScanCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></WrapPanel>
    <TextBlock Text="{Binding ProfileState}" Foreground="#52627A" FontSize="12"/>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#CCD5E2" BorderThickness="0,1,0,0" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/><ProgressBar Height="3" Margin="0,6,16,0" IsIndeterminate="{Binding Busy}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PageSummary}" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="16,10" BorderBrush="#CCD5E2" BorderThickness="0,1,0,0"><StackPanel>
   <WrapPanel IsEnabled="{Binding NotBusy}"><TextBlock Text="OUTPUT · selected pages only" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/><Label Content="Format"/><ComboBox Width="85" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}"/><Label Content="Prefix" Margin="12,0,0,0"/><TextBox Width="130" Text="{Binding FilenamePrefix,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding FilenamePreview}" VerticalAlignment="Center" Margin="14,0" Foreground="#52627A"/></WrapPanel>
   <WrapPanel HorizontalAlignment="Right"><Button Content="Retry pending delivery…" Command="{Binding RetryUploadCommand}"/><Button Content="Save Local" Command="{Binding SaveCommand}"/><Button Content="Send to ERPNext" Command="{Binding SendCommand}"/><Button Content="Save Local &amp; Send to ERPNext" Command="{Binding SaveAndSendCommand}" Background="#075DE8" Foreground="White"/></WrapPanel>
  </StackPanel></Border>
  <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="170"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="280" MinWidth="240"/></Grid.ColumnDefinitions>
   <DockPanel Background="#F5F7FB"><StackPanel DockPanel.Dock="Top" Margin="8"><TextBlock Text="Pages" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSummary}" Margin="0,5"/><WrapPanel><Button Content="Select all" Click="SelectAllClick"/><Button Content="Select blanks" Click="SelectBlanksClick"/></WrapPanel><Button Content="Import images…" Command="{Binding ImportCommand}"/></StackPanel>
    <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Extended" SelectionChanged="PagesChanged" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="PagesDrop" AutomationProperties.Name="Scanned pages; Ctrl or Shift to select multiple pages">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Width="140" Margin="6,8"><Border Background="White" Padding="6" BorderBrush="#CCD5E2" BorderThickness="1"><Image Source="{Binding Thumbnail}" Height="130" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="{Binding Rotation}"/></Image.LayoutTransform></Image></Border><TextBlock Text="{Binding Label}" Margin="0,6,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding BlankText}" Foreground="#875500" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
   <DockPanel Grid.Column="2" Margin="10,0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="↶ Rotate" Command="{Binding RotateLeftCommand}"/><Button Content="↷ Rotate" Command="{Binding RotateRightCommand}"/><Button Content="Manual Crop" Command="{Binding ManualCropCommand}"/><Button Content="Auto Crop" Command="{Binding CropCommand}"/><Button Content="Auto Color" Command="{Binding AutoColorCommand}"/><Button Content="Undo" Command="{Binding UndoCommand}"/>
    <Menu Background="Transparent" VerticalAlignment="Center"><MenuItem Header="More"><MenuItem Header="Rotate 180°" Command="{Binding Rotate180Command}"/><MenuItem Header="Reset crop" Command="{Binding ResetCropCommand}"/><MenuItem Header="Reset Auto Color" Command="{Binding ResetColorCommand}"/><MenuItem Header="Move up" Command="{Binding MoveUpCommand}"/><MenuItem Header="Move down" Command="{Binding MoveDownCommand}"/><MenuItem Header="Delete selected pages" Command="{Binding DeleteCommand}"/><Separator/><MenuItem Header="New document" Command="{Binding NewDocumentCommand}"/><MenuItem Header="Clear document (Undo available)" Command="{Binding ClearCommand}"/></MenuItem></Menu>
   </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewInfo}" HorizontalAlignment="Center" Foreground="#52627A" Margin="0,6" TextWrapping="Wrap"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"><CheckBox Content="Show original" IsChecked="{Binding ShowOriginal}" Margin="8"/><Button Content="−" Click="ZoomOutClick" ToolTip="Zoom out"/><Button Content="Fit" Click="FitClick"/><Button Content="+" Click="ZoomInClick" ToolTip="Zoom in"/></StackPanel>
    <Grid Background="#E4E9F0" ClipToBounds="True"><TextBlock Text="Scan or import pages to begin" FontSize="20" Foreground="#52627A" VerticalAlignment="Center" HorizontalAlignment="Center"/><ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="PreviewContainer" Width="{Binding ActualWidth,ElementName=PreviewScroll}" Height="{Binding ActualHeight,ElementName=PreviewScroll}" Background="Transparent"><Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" Margin="18"/></Grid></ScrollViewer></Grid>
   </DockPanel>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
   <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="White"><StackPanel Margin="16" IsEnabled="{Binding NotBusy}">
    <TextBlock Text="NEXT SCAN" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Applies to newly scanned pages" Foreground="#52627A" Margin="0,4,0,12"/>
    <TextBlock Text="{Binding CapabilityWarning}" Foreground="#875500" TextWrapping="Wrap"/>
    <Label Content="Paper source"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan paper source"/>
    <Label Content="DPI"/><ComboBox ItemsSource="{Binding Dpis}" SelectedItem="{Binding SelectedDpi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan DPI"/>
    <Label Content="Color"/><ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan color"/>
    <Label Content="Paper"/><ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Next scan paper size"/>
    <CheckBox Content="Landscape" IsChecked="{Binding Landscape}"/><CheckBox Content="Auto deskew" IsChecked="{Binding Deskew}"/><CheckBox Content="Auto crop" IsChecked="{Binding AutoCrop}"/><CheckBox Content="Mark possible blank pages" IsChecked="{Binding DetectBlank}"/>
    <Expander Header="Advanced scan defaults"><StackPanel><CheckBox Content="Review blank removal after scan" IsChecked="{Binding RemoveBlank}"/><CheckBox Content="Use native scanner dialog" IsChecked="{Binding NativeUi}" ToolTip="{l:Loc NativeToneHint}"/><Label Content="Brightness (−1000…1000)"/><TextBox Text="{Binding Brightness,UpdateSourceTrigger=PropertyChanged}"/><Label Content="Contrast (−1000…1000)"/><TextBox Text="{Binding Contrast,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Reset scan tone to 0" Command="{Binding ResetAdjustmentsCommand}"/></StackPanel></Expander>
    <Separator Margin="0,16"/><TextBlock Text="SELECTED PAGES" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Set values, then apply to selected pages" Foreground="#52627A" TextWrapping="Wrap" Margin="0,4,0,8"/>
    <Label Content="Brightness (−1000…1000)"/><Slider Minimum="-1000" Maximum="1000" SmallChange="10" Value="{Binding PageBrightness,Mode=TwoWay}" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Selected page brightness"/><TextBox Text="{Binding PageBrightness,UpdateSourceTrigger=PropertyChanged}"/>
    <Label Content="Contrast (−1000…1000)"/><Slider Minimum="-1000" Maximum="1000" SmallChange="10" Value="{Binding PageContrast,Mode=TwoWay}" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Selected page contrast"/><TextBox Text="{Binding PageContrast,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Apply tone to selected pages" Command="{Binding ApplyPageToneCommand}"/>
    <TextBlock Text="0 = no app adjustment. Originals are kept; Undo restores the previous edit." Foreground="#52627A" TextWrapping="Wrap" Margin="0,8"/>
    <Separator Margin="0,16"/><Expander Header="Network scanner"><StackPanel><Label Content="IP / eSCL endpoint"/><TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Connect scanner" Command="{Binding ConnectCommand}"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
