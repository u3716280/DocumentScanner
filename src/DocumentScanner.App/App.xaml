<Application x:Class="DocumentScanner.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Accent" Color="#2367D1"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F5F7FB"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4DBE8"/><Setter Property="Foreground" Value="#21334F"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/></Style>
 <Style TargetType="Label"><Setter Property="Padding" Value="0,3"/><Setter Property="Foreground" Value="#52627C"/></Style>
</Application.Resources></Application>
