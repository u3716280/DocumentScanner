<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Application tokens. Control templates come from WPF UI; this dictionary is merged after it,
        so the keys below override the library's accent and add the few brushes the workspace needs.
        It has no dependency on WPF UI resources at load time.
    -->

    <!-- Scanner glass: used only behind the page preview. -->
    <SolidColorBrush x:Key="PlatenBrush" Color="#23282E"/>
    <SolidColorBrush x:Key="PlatenTextBrush" Color="#E6EAEE"/>
    <SolidColorBrush x:Key="PlatenMutedBrush" Color="#A9B3BD"/>
    <SolidColorBrush x:Key="LampGlowBrush" Color="#7FE3F2"/>
    <SolidColorBrush x:Key="PlatenCardBrush" Color="#F0181C21"/>
    <SolidColorBrush x:Key="PlatenLineBrush" Color="#3A434D"/>

    <!-- Surfaces and text. -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MistBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DDE3EA"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1B2733"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6878"/>

    <!-- Accent (scan lamp) and states. State colours mark state only. -->
    <SolidColorBrush x:Key="LampBrush" Color="#08707F"/>
    <SolidColorBrush x:Key="LampTintBrush" Color="#E3F2F4"/>
    <SolidColorBrush x:Key="SentBrush" Color="#1E7D45"/>
    <SolidColorBrush x:Key="IdleBrush" Color="#8D98A5"/>
    <SolidColorBrush x:Key="BlankBrush" Color="#8A5A00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>

    <!-- WPF UI accent keys, fixed to the lamp colour instead of the Windows accent. -->
    <Color x:Key="SystemAccentColor">#0C8599</Color>
    <Color x:Key="SystemAccentColorPrimary">#0A7A8C</Color>
    <Color x:Key="SystemAccentColorSecondary">#08707F</Color>
    <Color x:Key="SystemAccentColorTertiary">#05505B</Color>
    <Color x:Key="AccentFillColorDefault">#08707F</Color>
    <Color x:Key="AccentFillColorSecondary">#E608707F</Color>
    <Color x:Key="AccentFillColorTertiary">#CC08707F</Color>
    <SolidColorBrush x:Key="SystemAccentBrush" Color="#0C8599"/>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#0C8599"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#0A7A8C"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#08707F"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#05505B"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#08707F"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#08707F"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#05505B"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0A7A8C"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#0C8599"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#08707F"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#08707F" Opacity="0.9"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#08707F" Opacity="0.8"/>
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#08707F"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0A7A8C"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#05505B"/>

    <!-- Text roles: 12 caption and field label, 14 body, 16 section, 20 empty state. -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
