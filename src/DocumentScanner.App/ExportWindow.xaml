<Window x:Class="DocumentScanner.App.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:DocumentScanner.App" Title="{l:Loc ExportTitle}" Width="540" Height="680" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
 <TextBlock Text="{l:Loc ExportTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
 <Label Content="{l:Loc Folder}"/><DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Browse}" Click="BrowseClick"/><TextBox x:Name="FolderBox"/></DockPanel>
 <Label Content="{l:Loc Filename}"/><TextBox x:Name="NameBox"/>
 <Label Content="{l:Loc Format}"/><ComboBox x:Name="FormatBox" SelectionChanged="FormatChanged"/>
 <Label Content="{l:Loc Quality}"/><TextBox x:Name="QualityBox" Text="90"/>
 <Label Content="{l:Loc PdfPaper}"/><ComboBox x:Name="PaperBox"/>
 <CheckBox x:Name="FitBox" Content="{l:Loc FitPage}" IsChecked="True"/>
 <CheckBox x:Name="SelectedBox" Content="{l:Loc SelectedOnly}"/>
 <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="#B03030" Margin="0,12"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{l:Loc Cancel}" IsCancel="True"/><Button Content="{l:Loc Export}" Click="SaveClick" IsDefault="True" Background="#2367D1" Foreground="White"/></StackPanel>
</StackPanel></ScrollViewer></Window>
